#include <dt-bindings/zmk/matrix_transform.h>

/ {
    // Falls das noch drinsteht, bitte entfernen:
    // compatible = "zmk,keyboard";

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";

        // Deine echten Pins hier (Beispiel!)
        row-gpios = < &gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) >,
                    < &gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) >,
                    < &gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) >,
                    < &gpio1 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) >,
                    < &gpio1 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) >;

        col-gpios = < &gpio0 31 GPIO_ACTIVE_HIGH >,
                    < &gpio0 29 GPIO_ACTIVE_HIGH >,
                    < &gpio0 2  GPIO_ACTIVE_HIGH >,
                    < &gpio1 15 GPIO_ACTIVE_HIGH >,
                    < &gpio1 13 GPIO_ACTIVE_HIGH >,
                    < &gpio1 11 GPIO_ACTIVE_HIGH >,
                    < &gpio0 10 GPIO_ACTIVE_HIGH >,
                    < &gpio0 9  GPIO_ACTIVE_HIGH >;
    };

    /* Matrix-Transform für 5x8-Matrix (40 logische Positionen) */
    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        rows = <5>;
        columns = <8>;

        map = <
            // Row 0, Col 0..7
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7)
            // Row 1
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7)
            // Row 2
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7)
            // Row 3
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7)
            // Row 4
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7)
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "mwv1 default";
        kscan = <&kscan0>;
        transform = <&default_transform>;
    };

    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };
};

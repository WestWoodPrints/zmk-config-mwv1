#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: DE-Basis
         * Umlaut-Tasten (bei deutschem OS-Layout):
         *   MINUS = ß
         *   LBKT  = ü
         *   SEMI  = ö
         *   SQT   = ä
         *
         * Hinweis: In deinen obersten zwei Reihen ist die letzte Taste physisch nicht da -> &none
         */
        default_layer {
            bindings = <
                /* Row 0 */
                &kp Q        &kp W        &kp E        &kp R        &kp T        &kp Z        &kp U        &none
                /* Row 1 */
                &kp A        &kp S        &kp D        &kp F        &kp G        &kp H        &kp J        &none
                /* Row 2 */
                &kp Y        &kp X        &kp C        &kp V        &kp B        &kp N        &kp M        &kp COMMA
                /* Row 3 */
                &kp TAB      &kp LSHFT    &kp LCTRL    &kp SPACE    &kp ENTER    &kp RALT     &kp SLASH    &kp DOT
                /* Row 4 */
                &kp ESC      &lt 1 LGUI   &kp MINUS    &kp EQUAL    &kp LBKT     &kp SEMI     &kp SQT      &kp BACKSPACE
            >;
        };

        /* Layer 1: Fn (Zahlen, F-Keys, Pfeile)
         * LGUI ist auf Layer 0 als Layer-Tap: Tippen = GUI, Halten = Fn
         */
        fn_layer {
            bindings = <
                /* Row 0 */
                &kp N1       &kp N2       &kp N3       &kp N4       &kp N5       &kp N6       &kp N7       &none
                /* Row 1 */
                &kp N8       &kp N9       &kp N0       &kp F1       &kp F2       &kp F3       &kp F4       &none
                /* Row 2 */
                &kp F5       &kp F6       &kp F7       &kp F8       &kp F9       &kp F10      &kp F11      &kp F12
                /* Row 3 */
                &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT    &kp HOME     &kp END      &kp PG_UP    &kp PG_DN
                /* Row 4 */
                &kp ESC      &trans       &kp DEL      &kp INS      &trans       &trans       &trans       &kp BACKSPACE
            >;
        };
    };
};

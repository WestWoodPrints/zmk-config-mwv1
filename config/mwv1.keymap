/ {
    keymap {
        compatible = "zmk,keymap";

        // Matrix Transform: 5 rows × 8 cols
        // Spalte 7 (letzte Spalte) enthält NUR Tasten in den unteren 3 Reihen
        matrix_transform {
            rows = <5>;
            columns = <8>;

            // physische Matrix-Anordnung (0 = Row 0 oben)
            // Col7 fehlt in Row0, Row1 → daher &none
            map = <
                // Row 0
                0   1   2   3   4   5   6   NONE
                // Row 1
                8   9  10  11  12  13  14   NONE
                // Row 2
                16 17 18 19 20 21 22 23
                // Row 3
                24 25 26 27 28 29 30 31
                // Row 4
                32 33 34 35 36 37 38 39
            >;
        };

        default_layer {
            bindings = <
                // Row 0
                &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Z     &kp U     &none
                // Row 1
                &kp A     &kp S     &kp D     &kp F     &kp G     &kp H     &kp J     &none
                // Row 2
                &kp Y     &kp X     &kp C     &kp V     &kp B     &kp N     &kp M     &kp COMMA
                // Row 3
                &kp TAB   &kp LSHFT &kp LCTRL &kp SPACE &kp ENTER &kp RALT &kp RSHFT &kp DOT
                // Row 4
                &kp ESC   &kp LGUI  &kp MINUS &kp EQUAL &kp KP_PLUS &kp KP_MINUS &kp SLASH &kp BACKSPACE
            >;
        };

        // OPTIONAL: weitere Layer können hier ergänzt werden
    };
};
